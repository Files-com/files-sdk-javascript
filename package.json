{
  "name": "files.com",
  "version": "2.0.11",
  "description": "Files.com SDK for JavaScript",
  "keywords": [
    "files.com",
    "cloud storage",
    "api"
  ],
  "homepage": "https://www.files.com/",
  "author": "Files.com <support@files.com> (https://www.files.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Files-com/files-sdk-javascript.git"
  },
  "contributors": [],
  "engines": {
    "node": ">=22"
  },
  "main": "lib/Files.js",
  "types": "lib/Files.root.d.ts",
  "module": "src/Files.js",
  "browser": {
    "./lib/isomorphic/Directory.node.js": false,
    "./lib/isomorphic/DownloadWorker.node.js": false,
    "./lib/isomorphic/DownloadWorkers.node.js": false,
    "./lib/isomorphic/File.node.js": false,
    "./lib/isomorphic/Filesystem.node.js": false,
    "./lib/isomorphic/UserAgent.node.js": "./lib/isomorphic/UserAgent.browser.js",
    "./src/isomorphic/Directory.node.js": false,
    "./src/isomorphic/DownloadWorker.node.js": false,
    "./src/isomorphic/DownloadWorkers.node.js": false,
    "./src/isomorphic/File.node.js": false,
    "./src/isomorphic/Filesystem.node.js": false,
    "./src/isomorphic/UserAgent.node.js": "./src/isomorphic/UserAgent.browser.js"
  },
  "bin": {
    "files-cli-ai": "bin/files-cli-ai"
  },
  "dependencies": {
    "@babel/runtime": "^7.10.3",
    "@types/node": ">=22.20.2",
    "cross-fetch": "^4.0.0",
    "readable-stream": "^4.4.0",
    "safe-buffer": "^5.2.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.10.3",
    "@babel/core": "^7.10.3",
    "@babel/eslint-parser": "^7.22.15",
    "@babel/plugin-proposal-class-properties": "^7.10.1",
    "@babel/plugin-transform-modules-commonjs": "^7.10.1",
    "@babel/plugin-transform-runtime": "^7.10.3",
    "@babel/preset-env": "^7.10.3",
    "eslint": "^8.51.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^27.4.2",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "nock": "^13.4.0",
    "typescript": "5.9.3",
    "typescript-current": "npm:typescript@7.0.2"
  },
  "scripts": {
    "build": "./node_modules/.bin/babel src -d lib",
    "test": "jest && npm run test:types",
    "test:types": "tsc -p test/types && tsc -p test/types/bundler && node node_modules/typescript-current/bin/tsc -p test/types && node node_modules/typescript-current/bin/tsc -p test/types/bundler",
    "lint": "eslint --fix src/",
    "watch": "jest --watch"
  }
}
