// Type-checks the consumers in this directory against the package's declarations with the strictest settings, and
// every declaration of lib/ and the package root itself, whichever models the schema generated: see
// `npm run test:types`. The package's own name resolves to this checkout's lib/, as an installed copy would.
{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "noEmit": true,
    "paths": {
      "files.com": ["../../lib/Files.root.d.ts"],
      "files.com/*": ["../../*"]
    }
  },
  "include": ["*.cts", "*.mts", "../../lib/**/*.d.ts", "../../*.d.ts"]
}
