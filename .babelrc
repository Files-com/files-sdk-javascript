{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "ie": "11"
        }
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-proposal-class-properties",
    ["@babel/plugin-transform-modules-commonjs", {
      "loose": true
    }],
    "@babel/plugin-transform-runtime"
  ],
  "overrides": [
    {
      "test": [
        "./src/isomorphic/File.node.js",
        "./lib/isomorphic/File.node.js"
      ],
      "presets": [
        [
          "@babel/preset-env",
          {
            "targets": {
              "node": "22"
            }
          }
        ]
      ]
    }
  ]
}
